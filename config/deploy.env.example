# Copy to config/deploy.env (git-ignored) and adjust. Used by tools/deploy.sh.

# The mounted server project folder in WSL: the folder that contains site/, config/ and docker-compose.yaml.
NAS_PROJECT_DIR=/mnt/nas/finplanr

# Optional: let the script mount the share itself when it is not mounted (WSL drvfs).
# NAS_MOUNT_SPEC is a Windows drive ('Z:') or a share path; NAS_MOUNT_POINT is where it is mounted in WSL.
# NAS_MOUNT_SPEC='\\server\share'
# NAS_MOUNT_POINT=/mnt/nas

# Optional, for `tools/deploy.sh release`: recreate the web container over SSH.
# NAS_SSH is user@host, NAS_REMOTE_DIR is the project folder path ON the server.
# NAS_SSH=admin@server
# NAS_REMOTE_DIR=/path/on/server/finplanr

# Public address used by `tools/deploy.sh check`
SITE_URL=https://finplanr.net
